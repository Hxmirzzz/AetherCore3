# Test fixtures - Ignore all .txt files in fixtures directories
tests/fixtures/**/*.txt

# But keep the directory structure
!tests/fixtures/
!tests/fixtures/**/

# Allow all Python files
!tests/**/*.py

# Allow other non-txt files in fixtures
!tests/fixtures/**/*.py
!tests/fixtures/**/*.md
!tests/fixtures/**/*.json
!tests/fixtures/**/*.yaml
!tests/fixtures/**/*.yml