# Directorios de existencias (entorno local/QA/PROD)
EXISTENCIAS_ORIGEN_DIR=C:\CERTIFICACIONES\NOMBRE_ENTIDAD\EXISTENCIAS\PLANOS
EXISTENCIAS_NACIONAL_DIR=C:\CERTIFICACIONES\NOMBRE_ENTIDAD\NACIONAL

# Directorio de logs (opcional)
EXISTENCIAS_LOG_DIR=C:\CERTIFICACIONES\NOMBRE_ENTIDAD\logs

# Configuración de caracteres especiales
# true = Mantener caracteres especiales (á, é, í, ó, ú, ñ, etc.)
# false = Limpiar caracteres especiales (DÓLAR -> DOLAR)
EXISTENCIAS_MANTENER_CARACTERES_ESPECIALES=true

# Notas sobre estructura de carpetas:
# El sistema creará automáticamente las siguientes subcarpetas:
# - PLANOS/GESTIONADOS (archivos procesados correctamente)
# - PLANOS/ERRORES (archivos con errores de formato)
# - NACIONAL/{YYMMDD}/COPIAS (versiones anteriores de archivos nacionales)